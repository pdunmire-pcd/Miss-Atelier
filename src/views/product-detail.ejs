<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/products.css">
</head>
<body>

<%- include('partials/nav') %>

<main class="product-detail-page">
   <a href="/products" class="back-link">
    ← Back to Products
</a>

    <section class="product-detail">
        <img src="<%= product.image_path %>" alt="<%= product.product_name %>" class="product-detail-image">

      <div class="product-detail-info">
    <h1><%= product.product_name %></h1>

    <div class="product-category">
        <%= product.category %>
    </div>

    <div class="product-price">
        $<%= product.price %>
    </div>

    <p class="product-description">
    <%= product.description %>
</p>

<% if (product.skill_level || product.sizes_included) { %>
<div class="product-meta">
    <% if (product.skill_level) { %>
        <p><strong>Skill Level:</strong> <%= product.skill_level %></p>
    <% } %>
    <% if (product.sizes_included) { %>
        <p><strong>Sizes Included:</strong> <%= product.sizes_included %></p>
    <% } %>
</div>
<% } %>

<% if (product.fiber_content || product.yarn_weight || product.yardage) { %>
<div class="product-meta">
    <% if (product.fiber_content) { %>
        <p><strong>Fiber:</strong> <%= product.fiber_content %></p>
    <% } %>
    <% if (product.yarn_weight) { %>
        <p><strong>Weight:</strong> <%= product.yarn_weight %></p>
    <% } %>
    <% if (product.yardage) { %>
        <p><strong>Yardage:</strong> <%= product.yardage %>m per skein</p>
    <% } %>
</div>
<% } %>

<form action="/bag/items" method="POST">
  <input type="hidden" name="productId" value="<%= product.id %>">
  <button type="submit" class="btn-add-cart">Add to Bag</button>
</form>

</div>
    </section>
</main>

<%- include('partials/footer') %>

</body>
</html>