<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<div class="site-container">

    <!-- NAVIGATION -->
    <header class="site-header">
        <div class="nav-wrapper">
            <a href="/" class="brand-logo">Miss Atelier</a>

            <nav>
                <ul class="nav-center">
                    <li><a href="/products?category=ready-to-wear" class="nav-link">Ready To Wear</a></li>
                    <li><a href="/products?category=patterns" class="nav-link">Patterns</a></li>
                    <li><a href="/products?category=yarn" class="nav-link">Yarn &amp; Notions</a></li>
                    <li><a href="/about" class="nav-link">About</a></li>
                    <li><a href="/journal" class="nav-link">Journal</a></li>
                </ul>
            </nav>

            <ul class="nav-right">
                <li><a href="/search" class="nav-utility">&#128269; Search</a></li>
                <li><a href="/account" class="nav-utility">Account</a></li>
                <li><a href="/bag" class="nav-utility">Bag (0)</a></li>
            </ul>
        </div>
    </header>

    <!-- MAIN -->
    <main>
        <section class="hero-section">

            <h1 class="hero-headline"><%= heroLine1 %><br><%= heroLine2 %></h1>

            <div class="hero-grid">

                <!-- Hero image — left -->
                <div class="hero-image-wrap">
                    <img src="<%= hero.image %>" alt="<%= hero.imageAlt %>">
                    <div class="hero-overlay">
                        <p class="hero-subtitle"><%= hero.subtitle %></p>
                        <a href="/products?category=ready-to-wear" class="btn-shop">Shop RTW</a>
                    </div>
                </div>

                <!-- Category tiles — right -->
                <div class="hero-tiles">

                    <div class="category-tile">
                        <div class="tile-image-wrap">
                            <img src="<%= tiles.patterns.image %>" alt="<%= tiles.patterns.imageAlt %>">
                        </div>
                        <div class="tile-label">
                            <span class="tile-name">Patterns</span>
                            <a href="/products?category=patterns" class="tile-cta">Download &amp; Create</a>
                        </div>
                    </div>

                    <div class="category-tile">
                        <div class="tile-image-wrap">
                            <img src="<%= tiles.yarn.image %>" alt="<%= tiles.yarn.imageAlt %>">
                        </div>
                        <div class="tile-label">
                            <span class="tile-name">Yarn</span>
                            <a href="/products?category=yarn" class="tile-cta">Explore The Fibers</a>
                        </div>
                    </div>

                </div>

            </div>
        </section>
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="footer-wrapper">
            <ul class="footer-nav">
                <li><a href="/contact" class="footer-link">Contact</a></li>
                <li><a href="/shipping" class="footer-link">Shipping</a></li>
                <li><a href="/sustainability" class="footer-link">Sustainability</a></li>
                <li><a href="https://instagram.com" class="footer-link">Instagram</a></li>
            </ul>
            <span class="footer-copy">&copy; <%= new Date().getFullYear() %> Miss Atelier</span>
        </div>
    </footer>

</div>

</body>
</html>
