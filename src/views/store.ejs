<!DOCTYPE html>
<html lang="en">
    <%- include('partials/head') %>
<body>

<div class="site-container">

    <%- include('partials/nav') %>

    <!-- MAIN -->
    <main>
        <section class="hero-section">

            <h1 class="hero-headline"><%= heroLine1 %><br><%= heroLine2 %></h1>

            <div class="hero-grid">

                <!-- Hero image — left -->
                <div class="hero-image-wrap">
                    <img src="<%= hero.image %>" alt="<%= hero.imageAlt %>">
                    <div class="hero-overlay">
                        <p class="hero-subtitle"><%= hero.subtitle %></p>
                        <a href="/products" class="btn-shop">Shop RTW</a>
                    </div>
                </div>

                <!-- Category tiles — right -->
                <div class="hero-tiles">

                    <div class="category-tile">
                        <div class="tile-image-wrap">
                            <img src="<%= tiles.patterns.image %>" alt="<%= tiles.patterns.imageAlt %>">
                        </div>
                        <div class="tile-label">
                            <span class="tile-name">Patterns</span>
                            <a href="/products?category=patterns" class="tile-cta">Download &amp; Create</a>
                        </div>
                    </div>

                    <div class="category-tile">
                        <div class="tile-image-wrap">
                            <img src="<%= tiles.yarn.image %>" alt="<%= tiles.yarn.imageAlt %>">
                        </div>
                        <div class="tile-label">
                            <span class="tile-name">Yarn</span>
                            <a href="/products?category=Yarn%20%26%20Notions" class="tile-cta">Explore The Fibers</a>
                        </div>
                    </div>

                </div>

            </div>
        </section>

        <!-- Store description section -->
        <section class="store-highlight">
            <div class="store-description">
                <img src="<%= storeDescription.image %>" alt="<%= storeDescription.name %>">
                <h2><%= storeDescription.heading %></h2>
                <p><%= storeDescription.text %></p>
            </div>

            <!-- Product spotlight section -->
            <div class="featured-product-card">
                <img src="<%= featuredProduct.image %>" alt="<%= featuredProduct.name %>">
                <div class="featured-product-info">
                    <h3><%= featuredProduct.name %></h3>
                    <p><%= featuredProduct.description %></p>
                    <p class="featured-price"><%= featuredProduct.price %></p>
                    <a href="/products/<%= featuredProduct.id %>" class="btn-shop">Shop Now</a>
                </div>
            </div>
        </section>

    </main>

    <%- include('partials/footer') %>

</div>

</body>
</html>